<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="FeedPicker"
        parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item
            name="android:fontFamily">sans</item>
        <item
            name="android:colorAccent">@color/picker_accent</item>
        <item
            name="android:colorControlActivated">@color/picker_accent</item>
        <item
            name="android:colorBackground">@color/picker_surface</item>
        <item
            name="android:colorBackgroundFloating">@color/picker_surface</item>
        <item
            name="android:textColorPrimary">@color/picker_ink</item>
        <item
            name="android:textColorSecondary">@color/picker_muted</item>
        <item
            name="android:datePickerStyle">@style/FeedDatePicker</item>
        <item
            name="android:timePickerStyle">@style/FeedTimePicker</item>
    </style>
    <style
        name="FeedPicker.Dark"
        parent="android:style/Theme.Material.Dialog.Alert">
        <item
            name="android:fontFamily">sans</item>
        <item
            name="android:colorAccent">@color/picker_accent</item>
        <item
            name="android:colorControlActivated">@color/picker_accent</item>
        <item
            name="android:colorBackground">@color/picker_surface</item>
        <item
            name="android:colorBackgroundFloating">@color/picker_surface</item>
        <item
            name="android:textColorPrimary">@color/picker_ink</item>
        <item
            name="android:textColorSecondary">@color/picker_muted</item>
        <item
            name="android:datePickerStyle">@style/FeedDatePicker</item>
        <item
            name="android:timePickerStyle">@style/FeedTimePicker</item>
    </style>
    <style
        name="FeedDatePicker"
        parent="android:style/Widget.Material.DatePicker">
        <item
            name="android:datePickerMode">calendar</item>
        <item
            name="android:headerBackground">@color/picker_soft</item>
        <item
            name="android:calendarTextColor">@color/picker_numbers_text</item>
    </style>
    <style
        name="FeedTimePicker"
        parent="android:style/Widget.Material.TimePicker">
        <item
            name="android:timePickerMode">clock</item>
        <item
            name="android:headerBackground">@color/picker_soft</item>
        <item
            name="android:numbersBackgroundColor">@color/picker_face</item>
        <item
            name="android:numbersTextColor">@color/picker_numbers_text</item>
        <item
            name="android:numbersInnerTextColor">@color/picker_numbers_text</item>
        <item
            name="android:numbersSelectorColor">@color/picker_accent</item>
    </style>
</resources>
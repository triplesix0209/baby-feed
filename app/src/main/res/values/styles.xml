<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="AppTheme"
        parent="android:style/Theme.Material.Light.NoActionBar">
        <item
            name="android:fontFamily">sans</item>
        <item
            name="android:colorAccent">#2D69CB</item>
        <item
            name="android:windowLightStatusBar">true</item>
        <item
            name="android:statusBarColor">#F7F9FC</item>
        <item
            name="android:navigationBarColor">#F7F9FC</item>
        <item
            name="android:windowBackground">#F7F9FC</item>
        <item
            name="android:windowActionModeOverlay">true</item>
    </style>
    <style
        name="AppTheme.Dark"
        parent="android:style/Theme.Material.NoActionBar">
        <item
            name="android:fontFamily">sans</item>
        <item
            name="android:colorAccent">#9DC2FF</item>
        <item
            name="android:windowLightStatusBar">false</item>
        <item
            name="android:statusBarColor">#11151D</item>
        <item
            name="android:navigationBarColor">#11151D</item>
        <item
            name="android:windowBackground">#11151D</item>
        <item
            name="android:windowActionModeOverlay">true</item>
    </style>
</resources>